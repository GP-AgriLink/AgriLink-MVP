# AgriLink Server Environment Variables
# Copy this file to .env and update with your actual values

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/agrilink?retryWrites=true&w=majority

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Authentication (use a strong secret in production)
JWT_SECRET=your_jwt_secret_key_here

# Email (Gmail requires App Password if 2FA enabled)
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your_app_password

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini AI (https://aistudio.google.com/app/api-keys)
AI_API_KEY=your_gemini_api_key
AI_MODEL_ID=gemini-2.5-flash-lite
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_FILES_UPLOAD_URL=https://generativelanguage.googleapis.com/upload/v1beta/files
AI_FILES_BASE_URL=https://generativelanguage.googleapis.com/v1beta/files
